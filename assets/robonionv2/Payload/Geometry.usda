        def Scope "custom"
        {
            def Scope "ros2_control"
            {
                custom string urdf:name = "Robinion2System"
                custom string urdf:type = "system"

                def Scope "hardware"
                {
                    def Scope "plugin"
                    {
                        custom string urdf:text = "mock_components/GenericSystem"
                    }
                }

                def Scope "joint"
                {
                    custom string urdf:name = "torso_pitch_joint"

                    def Scope "command_interface"
                    {
                        custom string urdf:name = "effort"
                    }

                    def Scope "state_interface"
                    {
                        custom string urdf:name = "position"
                    }

                    def Scope "state_interface_1" (
                        displayName = "state_interface"
                    )
                    {
                        custom string urdf:name = "velocity"
                    }

                    def Scope "state_interface_2" (
                        displayName = "state_interface"
                    )
                    {
                        custom string urdf:name = "effort"
                    }
                }

                def Scope "joint_1" (
                    displayName = "joint"
                )
                {
                    custom string urdf:name = "head_yaw_joint"

                    def Scope "command_interface"
                    {
